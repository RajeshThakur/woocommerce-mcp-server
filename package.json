{
  "name": "woocommerce-mcp-server",
  "version": "1.0.0",
  "description": "MCP server that lets AI agents read and manage a WooCommerce store (products, orders, customers, stats)",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "ts-node src/index.ts",
    "seed": "node scripts/seed.js",
    "seed:clean": "node scripts/seed.js --clean",
    "chat:cli": "node web/cli-test.js",
    "start:web": "node web/server.js"
  },
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RajeshThakur/woocommerce-mcp-server.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "woocommerce",
    "ai-agents",
    "claude"
  ],
  "author": "Rajesh Thakur",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/RajeshThakur/woocommerce-mcp-server/issues"
  },
  "homepage": "https://github.com/RajeshThakur/woocommerce-mcp-server#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "openai": "^7.43.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
